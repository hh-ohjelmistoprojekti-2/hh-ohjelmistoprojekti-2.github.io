{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "complexity": ["error", 4],
    "no-unused-vars": ["error"],
    "id-length": ["error", { "min": 2, "exceptions": ["i"] }],
    "max-statements": ["error", { "max": 10 }],
    "no-magic-numbers": ["error", { "ignore": [0, 1], "ignoreArrayIndexes": true }]
  }
}
